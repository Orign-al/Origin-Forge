{
  "name": "origin-forge-portal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "build": "pnpm --filter @h100-portal/web build",
    "dev": "pnpm --filter @h100-portal/web dev",
    "lint": "pnpm --filter @h100-portal/web lint",
    "typecheck": "pnpm --filter @h100-portal/web typecheck",
    "test": "pnpm --filter @h100-portal/web test",
    "test:e2e": "pnpm --filter @h100-portal/web test:e2e",
    "test:visual": "pnpm --filter @h100-portal/web test:visual",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
