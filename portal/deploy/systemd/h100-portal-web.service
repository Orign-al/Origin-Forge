[Unit]
Description=H100 Portal user ingress web console
Documentation=file:/opt/h100-portal/docs/deployment.md
Wants=h100-portal-api.service
After=network.target h100-portal-api.service

[Service]
Type=exec
User=h100-portal-web
Group=h100-portal-web
WorkingDirectory=/opt/h100-portal/apps/web/.next/standalone/apps/web
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=HOSTNAME=0.0.0.0
Environment=PORT=18080
ExecStart=/opt/node-v24.19.0/bin/node /opt/h100-portal/apps/web/.next/standalone/apps/web/server.js
SuccessExitStatus=143
Restart=on-failure
RestartSec=3s
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
IPAddressAllow=10.10.10.0/24
IPAddressAllow=20.10.10.0/24
IPAddressAllow=10.82.36.0/24
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027

[Install]
WantedBy=multi-user.target
