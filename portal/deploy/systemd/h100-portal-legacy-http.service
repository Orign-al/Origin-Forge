[Unit]
Description=H100 Portal legacy EasyTier HTTP proxy
Documentation=file:/opt/h100-portal/docs/deployment.md
Requires=h100-portal-web.service
After=h100-portal-web.service

[Service]
Type=exec
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 127.0.0.1:18080
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
IPAddressAllow=10.10.10.0/24
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
