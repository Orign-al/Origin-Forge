[Unit]
Description=Origin Forge fixed-operation root worker
Documentation=file:/opt/h100-portal/docs/root-worker-api.md
Requires=h100-portal-worker.socket
After=h100-portal-worker.socket docker.service slurmd.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/h100-portal
ExecStart=/opt/h100-portal/venv/bin/h100-portal-worker
Restart=on-failure
RestartSec=3s
NoNewPrivileges=yes
# The fixed submit path needs CAP_SETUID only until setpriv enters the managed UID.
# setpriv clears all child capability sets before it executes sbatch.
AmbientCapabilities=CAP_SETUID
PrivateTmp=yes
ProtectSystem=strict
# Stage must create the approved nologin home. ProtectSystem=strict plus the
# explicit /home ReadWritePaths entry keeps the writable scope bounded.
ProtectHome=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=no
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# The root Worker can reach these writable trees only through hash-pinned,
# fixed-argv lifecycle scripts.  Stage needs account databases and exact
# systemd/project mappings under /etc, managed homes, platform data, and the
# fixed lifecycle-script audit log.
ReadWritePaths=/etc /home /storage/users /storage/homes /srv/gpu-platform /run/h100-portal /var/lib/h100-portal /var/log/h100-portal /var/log/h100-platform-audit.log
# Portal-3F invokes the integrity-pinned GPU bypass guard inside the Worker
# namespace. Permit only its Node Exporter textfile output directory.
ReadWritePaths=/var/lib/node_exporter/textfile_collector
UMask=0077

[Install]
WantedBy=multi-user.target
