# This template contains no operational secret. Generate unique values during deployment.
PORTAL_DATABASE_URL=postgresql+psycopg://h100_portal:REPLACE_WITH_RANDOM_PASSWORD@/h100_portal?host=/var/run/postgresql
PORTAL_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
PORTAL_WORKER_SOCKET=/run/h100-portal/worker.sock
PORTAL_ALLOWED_ORIGINS=http://127.0.0.1:18080,http://10.10.10.2:18080
PORTAL_COOKIE_SECURE=false
PORTAL_ENVIRONMENT=production
