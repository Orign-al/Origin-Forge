#!/usr/bin/env bash
set -euo pipefail

source /usr/local/lib/h100-platform/h100-platform-common.sh

if [[ "${1:-}" == --help || $# -ne 1 ]]; then
  printf 'Usage: sudo h100-container-rebuild USER\n'
  [[ "${1:-}" == --help ]] && exit 0 || exit 2
fi

readonly user_name=$1
h100_require_root
h100_validate_username "${user_name}"
h100_acquire_lock
h100_install_audit_trap container-rebuild "${user_name}"
h100_require_managed_user "${user_name}"
h100_require_managed_compose "${user_name}"
h100_require_slurm_drained
h100_require_pilot_gpu_isolation_if_managed "${user_name}"

state_file="/etc/h100-platform/users/${user_name}.state"
if [[ -f "${state_file}" && ! -L "${state_file}" ]] \
  && grep -Fxq 'VERSION=4' "${state_file}"; then
  allocation_job_id="$(awk -F= '$1 == "GPU_ALLOCATION_JOB_ID" {print substr($0, index($0, "=") + 1)}' "${state_file}")"
  allocation_uuid="$(awk -F= '$1 == "GPU_ALLOCATION_UUID" {print substr($0, index($0, "=") + 1)}' "${state_file}")"
  [[ -z "${allocation_job_id}" && -z "${allocation_uuid}" ]] \
    || h100_fail 'GPU-bound Container must use the allocation-aware restart handler'
fi

container="$(h100_container_name "${user_name}")"
compose_file="$(h100_compose_file "${user_name}")"
config_dir="$(h100_config_dir "${user_name}")"
docker container inspect "${container}" >/dev/null 2>&1 \
  || h100_fail "container does not exist: ${container}"

docker compose \
  --project-directory "${config_dir}" \
  --file "${compose_file}" \
  config --quiet
docker compose \
  --project-directory "${config_dir}" \
  --file "${compose_file}" \
  up --detach --force-recreate --no-build
h100_wait_healthy "${container}" 120 \
  || h100_fail "rebuilt container did not become healthy: ${container}"

docker inspect "${container}" | jq -e '
  .[0] as $c
  | $c.HostConfig.Privileged == false
  and $c.HostConfig.NetworkMode != "host"
  and $c.HostConfig.PidMode != "host"
  and $c.HostConfig.IpcMode != "host"
  and (($c.HostConfig.DeviceRequests // []) | length == 0)
  and (($c.HostConfig.Devices // []) | length == 0)
' >/dev/null || h100_fail 'rebuilt container failed isolation validation'

printf 'REBUILT %s; bind-mounted user data preserved\n' "${container}"
h100_mark_success
