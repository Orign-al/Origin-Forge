install -o root -g gpu-platform-admin -m 0640 "${temp_dir}/state" "${state_file}"

last_successful_step=LIFECYCLE_STATE
current_step=GPU_GUARD_VERIFICATION
systemctl start "${GUARD_SERVICE}"
systemctl is-failed --quiet "${GUARD_SERVICE}" && fail 'GPU bypass Guard failed'
"${GPU_ISOLATION_TOOL}" verify "${username}"
last_successful_step=GPU_GUARD_VERIFICATION
current_step=COMPLETED
committed=1
printf 'COMPUTE STAGED user=%s uid=%s gid=%s project_id=%s ssh_port=%s container=%s state=STOPPED lease=NOT_STARTED host_ssh=DISABLED\n' \
  "${username}" "${uid}" "${gid}" "${project_id}" "${ssh_port}" "${container_name}"
