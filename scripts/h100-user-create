#!/usr/bin/env bash
# Markdown report format strings intentionally contain literal backticks.
# shellcheck disable=SC2016
set -euo pipefail

source /usr/local/lib/h100-platform/h100-platform-common.sh

readonly PILOT_UID_MIN=20000
readonly PILOT_UID_MAX=60000
readonly PROJECT_ID_MIN=30000
readonly PROJECT_ID_MAX=39999
readonly STATE_DIR=/etc/h100-platform/users
readonly MULTIGPU_QOS=portal-approved-multigpu
readonly ISOLATION_TOOL=/usr/local/sbin/h100-user-gpu-isolation
readonly GUARD_TIMER=h100-gpu-bypass-guard.timer
readonly GUARD_SERVICE=h100-gpu-bypass-guard.service
readonly SSH_KEY_STAGING_ROOT=/var/lib/h100-portal/ssh-key-staging
readonly MAX_PUBLIC_KEY_BYTES=16384
readonly MAX_PUBLIC_KEYS=5

mode=
user_name=
user_uid=
user_gid=
project_id=
ssh_port=
slurm_account=
slurm_qos=
public_key_input=
host_public_key_input=
container_public_key_input=
project_name=
user_root=
workspace_root=
state_file=
key_hash=
key_fingerprints_csv=
host_key_hash=
host_key_fingerprints_csv=
container_key_hash=
container_key_fingerprints_csv=
OUTCOME=FAILED
ROLLBACK_KIND=
backup_dir=
report_file=
temp_dir=
account_created=0
isolation_applied=0
project_mappings_changed=0
association_created=0
container_created=0
host_key_installed=0
data_key_installed=0
timer_was_enabled=0
guard_timer_changed=0
declare -a normalized_keys=()
declare -a key_fingerprints=()
declare -a host_normalized_keys=()
declare -a host_key_fingerprints=()
declare -a container_normalized_keys=()
declare -a container_key_fingerprints=()

usage() {
  printf '%s\n' \
    'Usage:' \
    '  sudo h100-user-create --plan USER UID GID PROJECT_ID SSH_PORT ACCOUNT QOS' \
    '  sudo h100-user-create --stage USER UID GID PROJECT_ID SSH_PORT ACCOUNT QOS --confirm-stage USER' \
    '  sudo h100-user-create --activate USER --public-key-file ROOT_CONTROLLED_FILE --confirm-activate USER' \
    '  sudo h100-user-create --activate USER --host-public-key-file ROOT_CONTROLLED_HOST_FILE --container-public-key-file ROOT_CONTROLLED_CONTAINER_FILE --confirm-activate USER' \
    '  sudo h100-user-create --rollback-activate USER --confirm-rollback-activate USER' \
    '  sudo h100-user-create --status USER' \
    '' \
    'Stage creates a locked nologin account, exact user-UID.slice policy, quota,' \
    'Slurm association, and GPU-less container, but installs no authorized_keys.' \
    'Activate revalidates every boundary before enabling public-key access.' \
    'The single-file form installs the same approved keys at both targets; the' \
    'target-scoped form keeps Host and Container key sets independent.'
}

stage_report_failure() {
  [[ -n "${report_file}" ]] || return 0
  {
    printf '# H100 Pilot user staged transaction failure\n\n'
    printf -- '- User: `%s`\n' "${user_name}"
    printf -- '- Result: `STAGE FAILED — ACCOUNT KEPT NON-LOGIN`\n'
    printf -- '- Shell: `/usr/sbin/nologin`\n'
    printf -- '- Public key installed: `no`\n'
    printf -- '- User data: preserved if created; not silently deleted\n'
    printf -- '- Container: stopped if created\n'
    printf -- '- Slurm association: removed if created\n'
    printf -- '- Project mappings: restored from backup if changed\n'
    printf -- '- Per-UID GPU policy: removed if created\n'
    printf -- '- Backup: `%s`\n' "${backup_dir}"
    printf -- '- Recovery: inspect the backup and audit log before retrying\n'
  } >"${report_file}"
}

restore_mapping_file() {
  local source=$1 target=$2 temp
  temp="$(mktemp "${target}.rollback.XXXXXX")"
  install -o root -g root -m 0644 "${source}" "${temp}"
  sync -f "${temp}"
  mv -f -- "${temp}" "${target}"
}

write_state() {
  local status=$1 temp state_key_hash state_key_fingerprints
  local state_host_key_hash state_host_key_fingerprints
  local state_container_key_hash state_container_key_fingerprints ssh_key_state
  case "${status}" in
    ACTIVE)
      state_key_hash=${key_hash}
      state_key_fingerprints=${key_fingerprints_csv}
      state_host_key_hash=${host_key_hash}
      state_host_key_fingerprints=${host_key_fingerprints_csv}
      state_container_key_hash=${container_key_hash}
      state_container_key_fingerprints=${container_key_fingerprints_csv}
      ssh_key_state=INSTALLED
      ;;
    *)
      state_key_hash=
      state_key_fingerprints=
      state_host_key_hash=
      state_host_key_fingerprints=
      state_container_key_hash=
      state_container_key_fingerprints=
      ssh_key_state=REQUIRED_BEFORE_ACTIVATION
      ;;
  esac
  install -d -o root -g gpu-platform-admin -m 0750 "${STATE_DIR}"
  temp="$(mktemp "${STATE_DIR}/.${user_name}.state.XXXXXX")"
  {
    printf 'VERSION=2\n'
    printf 'STATUS=%s\n' "${status}"
    printf 'USERNAME=%s\n' "${user_name}"
    printf 'UID=%s\n' "${user_uid}"
    printf 'GID=%s\n' "${user_gid}"
    printf 'PROJECT_ID=%s\n' "${project_id}"
    printf 'SSH_PORT=%s\n' "${ssh_port}"
    printf 'SLURM_ACCOUNT=%s\n' "${slurm_account}"
    printf 'SLURM_QOS=%s\n' "${slurm_qos}"
    printf 'MAX_GPUS=1\n'
    printf 'SSH_KEY_STATE=%s\n' "${ssh_key_state}"
    printf 'KEY_SHA256=%s\n' "${state_key_hash}"
    printf 'KEY_FINGERPRINTS=%s\n' "${state_key_fingerprints}"
    printf 'HOST_KEY_SHA256=%s\n' "${state_host_key_hash}"
    printf 'HOST_KEY_FINGERPRINTS=%s\n' "${state_host_key_fingerprints}"
    printf 'CONTAINER_KEY_SHA256=%s\n' "${state_container_key_hash}"
    printf 'CONTAINER_KEY_FINGERPRINTS=%s\n' "${state_container_key_fingerprints}"
    printf 'UPDATED_AT=%s\n' "$(date --iso-8601=seconds)"
  } >"${temp}"
  chown root:gpu-platform-admin "${temp}"
  chmod 0640 "${temp}"
  sync -f "${temp}"
  mv -f -- "${temp}" "${state_file}"
}

rollback_stage() {
  set +e
  printf 'STAGE ROLLBACK STARTED user=%s\n' "${user_name}" >&2
  if ((account_created == 1)); then
    usermod --shell /usr/sbin/nologin "${user_name}"
    passwd -l "${user_name}" >/dev/null
    if [[ -e "/home/${user_name}/.ssh/authorized_keys" ]]; then
      mv -f -- "/home/${user_name}/.ssh/authorized_keys" \
        "${backup_dir}/host-authorized_keys.unexpected"
    fi
    if [[ -e "${user_root}/home/.ssh/authorized_keys" ]]; then
      mv -f -- "${user_root}/home/.ssh/authorized_keys" \
        "${backup_dir}/data-authorized_keys.unexpected"
    fi
  fi
  if ((container_created == 1)); then
    local compose_file config_dir
    compose_file="$(h100_compose_file "${user_name}")"
    config_dir="$(h100_config_dir "${user_name}")"
    if [[ -f "${compose_file}" ]]; then
      docker compose \
        --project-directory "${config_dir}" \
        --file "${compose_file}" \
        down --remove-orphans
    fi
  fi
  if ((guard_timer_changed == 1 && timer_was_enabled == 0)); then
    systemctl disable --now "${GUARD_TIMER}" >/dev/null 2>&1 || true
  fi
  if ((association_created == 1)); then
    sacctmgr -i delete user where \
      Name="${user_name}" Account="${slurm_account}" >/dev/null
  fi
  if ((project_mappings_changed == 1)); then
    xfs_quota -x -c "limit -p bhard=0 ${project_id}" "${H100_DATA_ROOT}" \
      >/dev/null 2>&1 || true
    restore_mapping_file "${backup_dir}/projects.before" /etc/projects
    restore_mapping_file "${backup_dir}/projid.before" /etc/projid
  fi
  if ((isolation_applied == 1)); then
    "${ISOLATION_TOOL}" remove "${user_name}" \
      >"${backup_dir}/isolation-remove.log" 2>&1 \
      || printf 'WARNING: per-UID isolation rollback requires manual review\n' >&2
  fi
  if ((account_created == 1)); then
    write_state FAILED_STAGED
  fi
  stage_report_failure
  printf 'STAGE ROLLBACK COMPLETE — data/account preserved, login disabled\n' >&2
  set -e
}

rollback_activate() {
  set +e
  printf 'ACTIVATION ROLLBACK STARTED user=%s\n' "${user_name}" >&2
  usermod --shell /usr/sbin/nologin "${user_name}"
  passwd -l "${user_name}" >/dev/null
  if ((host_key_installed == 1)) && [[ -e "/home/${user_name}/.ssh/authorized_keys" ]]; then
    mv -f -- "/home/${user_name}/.ssh/authorized_keys" \
      "${backup_dir}/host-authorized_keys.failed-activation"
  fi
  if ((data_key_installed == 1)) \
    && [[ -e "${user_root}/home/.ssh/authorized_keys" ]]; then
    mv -f -- "${user_root}/home/.ssh/authorized_keys" \
      "${backup_dir}/data-authorized_keys.failed-activation"
  fi
  if docker container inspect "$(h100_container_name "${user_name}")" \
    >/dev/null 2>&1; then
    docker stop --time 30 "$(h100_container_name "${user_name}")" >/dev/null \
      || true
  fi
  if ((timer_was_enabled == 0)); then
    systemctl disable --now "${GUARD_TIMER}" >/dev/null 2>&1 || true
  fi
  write_state STAGED
  {
    printf '# H100 Pilot user activation failure\n\n'
    printf -- '- User: `%s`\n' "${user_name}"
    printf -- '- Result: `ACTIVATION FAILED — RETURNED TO STAGED`\n'
    printf -- '- Shell: `/usr/sbin/nologin`\n'
    printf -- '- authorized_keys: removed to `%s`\n' "${backup_dir}"
    printf -- '- Container: stopped\n'
    printf -- '- Per-UID GPU policy and user data: retained\n'
    printf -- '- Slurm node: remains DRAIN\n'
  } >"${report_file}"
  printf 'ACTIVATION ROLLBACK COMPLETE — manual review required\n' >&2
  set -e
}

on_exit() {
  local rc=$?
  trap - EXIT
  if [[ "${rc}" -ne 0 ]]; then
    case "${ROLLBACK_KIND}" in
      stage) rollback_stage ;;
      activate) rollback_activate ;;
    esac
  fi
  h100_audit \
    "user-${mode:-unknown}" \
    "${user_name:-none}" \
    "${OUTCOME}" \
    "${rc}"
  if [[ -n "${temp_dir}" ]]; then
    case "${temp_dir}" in
      /tmp/h100-user-create.*) rm -rf -- "${temp_dir}" ;;
    esac
  fi
  exit "${rc}"
}

validate_identity_numbers() {
  [[ "${user_uid}" =~ ^[0-9]+$ && "${user_gid}" =~ ^[0-9]+$ ]] \
    || h100_fail 'UID and GID must be numeric'
  ((user_uid >= PILOT_UID_MIN && user_uid <= PILOT_UID_MAX)) \
    || h100_fail "UID must be in ${PILOT_UID_MIN}-${PILOT_UID_MAX}"
  ((user_gid >= PILOT_UID_MIN && user_gid <= PILOT_UID_MAX)) \
    || h100_fail "GID must be in ${PILOT_UID_MIN}-${PILOT_UID_MAX}"
  case "${user_name}:${user_uid}" in
    root:*|origin-al:*|codexops:*|nobody:*|*:0|*:1000|*:1001|*:65534)
      h100_fail 'protected account or UID is forbidden'
      ;;
  esac
}

validate_slurm_name() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$ ]] \
    || h100_fail 'invalid Slurm account or QOS name'
}

public_key_file_metadata() {
  local candidate=$1 require_staging=$2 expected_uid=$3 expected_gid=$4
  local parent base file_type owner_uid owner_gid mode links size
  [[ -n "${candidate}" ]] || h100_fail 'PUBLIC_KEY_REQUIRED_FOR_ACTIVATION'
  parent="$(dirname -- "${candidate}")"
  base="$(basename -- "${candidate}")"
  if ((require_staging == 1)); then
    [[ "${parent}" == "${SSH_KEY_STAGING_ROOT}" ]] \
      || h100_fail 'PUBLIC_KEY_PATH_NOT_ALLOWED'
    [[ "${base}" =~ ^[0-9A-Fa-f-]{36}(\.(host|container))?\.pub$ ]] \
      || h100_fail 'PUBLIC_KEY_PATH_NOT_ALLOWED'
    [[ -d "${SSH_KEY_STAGING_ROOT}" && ! -L "${SSH_KEY_STAGING_ROOT}" ]] \
      || h100_fail 'PUBLIC_KEY_STAGING_DIRECTORY_INVALID'
    [[ "$(stat -c '%U:%G:%a' "${SSH_KEY_STAGING_ROOT}")" == 'root:root:700' ]] \
      || h100_fail 'PUBLIC_KEY_STAGING_DIRECTORY_INVALID'
  else
    [[ "${parent}" == "/home/${user_name}/.ssh" \
      || "${parent}" == "${user_root}/home/.ssh" ]] \
      || h100_fail 'AUTHORIZED_KEYS_PATH_INVALID'
    [[ "$(stat -c '%U:%G:%a' "${parent}" 2>/dev/null || true)" == \
      "${user_name}:${user_name}:700" ]] \
      || h100_fail 'AUTHORIZED_KEYS_PARENT_INVALID'
  fi
  file_type="$(stat -c '%F' -- "${candidate}" 2>/dev/null || true)"
  owner_uid="$(stat -c '%u' -- "${candidate}" 2>/dev/null || true)"
  owner_gid="$(stat -c '%g' -- "${candidate}" 2>/dev/null || true)"
  mode="$(stat -c '%a' -- "${candidate}" 2>/dev/null || true)"
  links="$(stat -c '%h' -- "${candidate}" 2>/dev/null || true)"
  size="$(stat -c '%s' -- "${candidate}" 2>/dev/null || true)"
  [[ ! -L "${candidate}" && "${file_type}" == 'regular file' ]] \
    || h100_fail 'PUBLIC_KEY_VALIDATION_FAILED'
  [[ "${owner_uid}" == "${expected_uid}" && "${owner_gid}" == "${expected_gid}" ]] \
    || h100_fail 'PUBLIC_KEY_FILE_OWNERSHIP_INVALID'
  [[ "${links}" == 1 ]] || h100_fail 'PUBLIC_KEY_VALIDATION_FAILED'
  [[ "${mode}" =~ ^[0-7]+$ ]] || h100_fail 'PUBLIC_KEY_VALIDATION_FAILED'
  (( (8#${mode}) & 022 )) && h100_fail 'PUBLIC_KEY_FILE_PERMISSIONS_INVALID'
  if ((require_staging == 0)); then
    [[ "${mode}" == 600 ]] || h100_fail 'AUTHORIZED_KEYS_PERMISSIONS_INVALID'
  fi
  [[ "${size}" =~ ^[0-9]+$ ]] || h100_fail 'PUBLIC_KEY_VALIDATION_FAILED'
  ((size > 0 && size <= MAX_PUBLIC_KEY_BYTES)) \
    || h100_fail 'PUBLIC_KEY_SIZE_INVALID'
}

parse_public_key_file() {
  local require_staging=$1 expected_uid=$2 expected_gid=$3
  public_key_file_metadata "${public_key_input}" "${require_staging}" \
    "${expected_uid}" "${expected_gid}"
  normalized_keys=()
  key_fingerprints=()
  local raw key_type key_blob rest fingerprint
  local -A seen_fingerprints=()
  while IFS= read -r raw || [[ -n "${raw}" ]]; do
    [[ "${raw}" =~ ^[[:space:]]*$ ]] && continue
    [[ "${raw}" != *$'\r'* && "${raw}" != *'BEGIN '* ]] \
      || h100_fail 'PUBLIC_KEY_VALIDATION_FAILED'
    read -r key_type key_blob rest <<<"${raw}"
    case "${key_type:-}" in
      ssh-ed25519|ecdsa-sha2-nistp256|sk-ssh-ed25519@openssh.com) ;;
      *) h100_fail 'PUBLIC_KEY_VALIDATION_FAILED' ;;
    esac
    [[ -n "${key_blob:-}" && "${key_blob}" =~ ^[A-Za-z0-9+/]+={0,3}$ ]] \
      || h100_fail 'PUBLIC_KEY_VALIDATION_FAILED'
    fingerprint="$(ssh-keygen -lf <(printf '%s\n' "${raw}") -E sha256 2>/dev/null \
      | awk '{print $2}')" || h100_fail 'PUBLIC_KEY_VALIDATION_FAILED'
    [[ "${fingerprint}" == SHA256:* ]] \
      || h100_fail 'PUBLIC_KEY_VALIDATION_FAILED'
    [[ -z "${seen_fingerprints[${fingerprint}]+present}" ]] \
      || h100_fail 'PUBLIC_KEY_DUPLICATE'
    seen_fingerprints[${fingerprint}]=1
    normalized_keys+=("${raw}")
    key_fingerprints+=("${fingerprint}")
  done <"${public_key_input}"
  ((${#normalized_keys[@]} >= 1 && ${#normalized_keys[@]} <= MAX_PUBLIC_KEYS)) \
    || h100_fail 'PUBLIC_KEY_VALIDATION_FAILED'
  key_hash="$({ printf '%s\n' "${normalized_keys[@]}"; } | sha256sum | awk '{print $1}')"
  key_fingerprints_csv="$(IFS=,; printf '%s' "${key_fingerprints[*]}")"
  if ((require_staging == 1)); then
    public_key_file_metadata "${public_key_input}" 1 0 0
  fi
}

validate_public_key_set() {
  parse_public_key_file 1 0 0

  local existing_state existing_fingerprints candidate
  shopt -s nullglob
  for existing_state in "${STATE_DIR}"/*.state; do
    [[ "${existing_state}" == "${state_file}" ]] && continue
    existing_fingerprints="$(awk -F= '$1 == "KEY_FINGERPRINTS" {print substr($0, index($0, "=") + 1)}' \
      "${existing_state}")"
    for candidate in "${key_fingerprints[@]}"; do
      if tr ',' '\n' <<<"${existing_fingerprints}" | grep -Fxq "${candidate}"; then
        h100_fail 'PUBLIC_KEY_DUPLICATE'
      fi
    done
  done
  shopt -u nullglob
}

select_host_key_set() {
  public_key_input=${host_public_key_input}
  normalized_keys=("${host_normalized_keys[@]}")
  key_fingerprints=("${host_key_fingerprints[@]}")
  key_hash=${host_key_hash}
  key_fingerprints_csv=${host_key_fingerprints_csv}
}

select_container_key_set() {
  public_key_input=${container_public_key_input}
  normalized_keys=("${container_normalized_keys[@]}")
  key_fingerprints=("${container_key_fingerprints[@]}")
  key_hash=${container_key_hash}
  key_fingerprints_csv=${container_key_fingerprints_csv}
}

select_combined_key_state() {
  local -A seen=()
  local candidate
  local -a combined_fingerprints=()
  for candidate in "${host_key_fingerprints[@]}" "${container_key_fingerprints[@]}"; do
    [[ -n "${seen[${candidate}]+present}" ]] && continue
    seen[${candidate}]=1
    combined_fingerprints+=("${candidate}")
  done
  ((${#combined_fingerprints[@]} >= 1 && ${#combined_fingerprints[@]} <= MAX_PUBLIC_KEYS)) \
    || h100_fail 'PUBLIC_KEY_VALIDATION_FAILED'
  key_fingerprints=("${combined_fingerprints[@]}")
  key_fingerprints_csv="$(IFS=,; printf '%s' "${combined_fingerprints[*]}")"
  key_hash="$({
    printf 'HOST\n'
    printf '%s\n' "${host_normalized_keys[@]}"
    printf 'CONTAINER\n'
    printf '%s\n' "${container_normalized_keys[@]}"
  } | sha256sum | awk '{print $1}')"
  public_key_input=
  normalized_keys=()
}

validate_public_keys() {
  public_key_input=${host_public_key_input}
  validate_public_key_set
  host_normalized_keys=("${normalized_keys[@]}")
  host_key_fingerprints=("${key_fingerprints[@]}")
  host_key_hash=${key_hash}
  host_key_fingerprints_csv=${key_fingerprints_csv}

  public_key_input=${container_public_key_input}
  validate_public_key_set
  container_normalized_keys=("${normalized_keys[@]}")
  container_key_fingerprints=("${key_fingerprints[@]}")
  container_key_hash=${key_hash}
  container_key_fingerprints_csv=${key_fingerprints_csv}

  select_combined_key_state
}

validate_new_user_plan() {
  h100_validate_username "${user_name}"
  validate_identity_numbers
  [[ "${project_id}" =~ ^[0-9]+$ ]] || h100_fail 'project ID must be numeric'
  ((project_id >= PROJECT_ID_MIN && project_id <= PROJECT_ID_MAX)) \
    || h100_fail "project ID must be in ${PROJECT_ID_MIN}-${PROJECT_ID_MAX}"
  h100_validate_port "${ssh_port}"
  validate_slurm_name "${slurm_account}"
  validate_slurm_name "${slurm_qos}"
  h100_require_slurm_drained
  [[ "$(squeue -h | wc -l)" -eq 0 ]] || h100_fail 'Slurm queue must be empty'
  getent passwd "${user_name}" >/dev/null \
    && h100_fail "host user already exists: ${user_name}"
  getent group "${user_name}" >/dev/null \
    && h100_fail "host group already exists: ${user_name}"
  getent passwd "${user_uid}" >/dev/null \
    && h100_fail "UID already exists: ${user_uid}"
  getent group "${user_gid}" >/dev/null \
    && h100_fail "GID already exists: ${user_gid}"
  [[ ! -e "${user_root}" ]] || h100_fail 'managed user data path already exists'
  [[ -d "${H100_WORKSPACE_ROOT}" && ! -L "${H100_WORKSPACE_ROOT}" ]] \
    || h100_fail 'canonical workspace root is unavailable'
  [[ ! -e "${workspace_root}" ]] || h100_fail 'managed workspace path already exists'
  [[ ! -e "${state_file}" ]] || h100_fail 'Pilot user state file already exists'
  grep -q "^${project_name}:" /etc/projid \
    && h100_fail 'project name already exists'
  grep -Eq ":${project_id}[[:space:]]*$" /etc/projid \
    && h100_fail 'project ID already exists in /etc/projid'
  grep -Eq "^${project_id}:" /etc/projects \
    && h100_fail 'project ID already exists in /etc/projects'
  if ss -H -lnt "sport = :${ssh_port}" | grep -q .; then
    h100_fail "SSH port is already in use: ${ssh_port}"
  fi
  local existing_state
  shopt -s nullglob
  for existing_state in "${STATE_DIR}"/*.state; do
    grep -Fxq "PROJECT_ID=${project_id}" "${existing_state}" \
      && h100_fail 'project ID is already reserved by a Pilot state file'
    grep -Fxq "SSH_PORT=${ssh_port}" "${existing_state}" \
      && h100_fail 'SSH port is already reserved by a Pilot state file'
  done
  shopt -u nullglob
  local registry_count
  registry_count="$(awk '$0 !~ /^[[:space:]]*(#|$)/ {count++} END {print count+0}' \
    /etc/h100-platform/gpu-isolated-users)"
  ((registry_count < 3)) || h100_fail 'Pilot user limit of 3 has been reached'
  sacctmgr -nP show account "${slurm_account}" format=Account \
    | awk -F'|' -v account="${slurm_account}" '$1 == account {found=1} END {exit found ? 0 : 1}' \
    || h100_fail 'approved Slurm account does not exist'
  local qos_record
  qos_record="$(sacctmgr -nP show qos "${slurm_qos}" format=Name,MaxTRESPerUser)"
  awk -F'|' -v qos="${slurm_qos}" '$1 == qos {found=1} END {exit found ? 0 : 1}' \
    <<<"${qos_record}" || h100_fail 'approved Slurm QOS does not exist'
  grep -Eq "^${slurm_qos}\|.*gres/gpu=1" <<<"${qos_record}" \
    || h100_fail 'Pilot QOS must enforce MaxTRESPerUser gres/gpu=1'
  sacctmgr -nP show qos "${MULTIGPU_QOS}" format=Name,MaxTRESPerUser \
    | awk -F'|' -v qos="${MULTIGPU_QOS}" \
        '$1 == qos && $2 ~ /gres\/gpu=4/ {found=1} END {exit !found}' \
    || h100_fail 'approved multi-GPU QOS is unavailable'
  if sacctmgr -nP show assoc where User="${user_name}" format=User,Account \
    | awk -F'|' -v user="${user_name}" '$1 == user {found=1} END {exit found ? 0 : 1}'; then
    h100_fail 'Slurm association already exists for username'
  fi
}

state_value() {
  local key=$1
  awk -F= -v key="${key}" '
    $1 == key { print substr($0, index($0, "=") + 1); found=1 }
    END { exit found ? 0 : 1 }
  ' "${state_file}"
}

load_staged_state() {
  h100_validate_username "${user_name}"
  [[ -f "${state_file}" && ! -L "${state_file}" ]] \
    || h100_fail 'USER_NOT_IN_STAGED_STATE'
  [[ "$(stat -c '%U:%G:%a' "${state_file}")" == \
    'root:gpu-platform-admin:640' ]] \
    || h100_fail 'Pilot user state ownership or mode is invalid'
  [[ "$(state_value VERSION)" == 1 || "$(state_value VERSION)" == 2 ]] \
    || h100_fail 'unsupported state version'
  [[ "$(state_value STATUS)" == STAGED ]] \
    || h100_fail 'USER_NOT_IN_STAGED_STATE'
  [[ "$(state_value USERNAME)" == "${user_name}" ]] \
    || h100_fail 'state username mismatch'
  user_uid="$(state_value UID)"
  user_gid="$(state_value GID)"
  project_id="$(state_value PROJECT_ID)"
  ssh_port="$(state_value SSH_PORT)"
  slurm_account="$(state_value SLURM_ACCOUNT)"
  slurm_qos="$(state_value SLURM_QOS)"
  if [[ "$(state_value VERSION)" == 2 ]]; then
    [[ "$(state_value SSH_KEY_STATE)" == REQUIRED_BEFORE_ACTIVATION ]] \
      || h100_fail 'STAGED user has an invalid SSH key state'
    [[ -z "$(state_value KEY_SHA256)" && -z "$(state_value KEY_FINGERPRINTS)" ]] \
      || h100_fail 'STAGED user unexpectedly has installed SSH key metadata'
  fi
  project_name="h100_${user_name}"
  user_root="${H100_DATA_ROOT}/users/${user_name}"
  workspace_root="${H100_WORKSPACE_ROOT}/${user_uid}"
  validate_identity_numbers
  [[ "$(id -u "${user_name}")" == "${user_uid}" ]] \
    || h100_fail 'host UID no longer matches staged state'
  [[ "$(id -g "${user_name}")" == "${user_gid}" ]] \
    || h100_fail 'host GID no longer matches staged state'
  [[ "$(getent passwd "${user_name}" | cut -d: -f7)" == /usr/sbin/nologin ]] \
    || h100_fail 'USER_NOT_IN_STAGED_STATE'
  [[ "$(passwd -S "${user_name}" | awk '{print $2}')" == L ]] \
    || h100_fail 'USER_NOT_IN_STAGED_STATE'
}

load_active_state_for_rollback() {
  h100_validate_username "${user_name}"
  [[ -f "${state_file}" && ! -L "${state_file}" ]] \
    || h100_fail 'ACTIVE user state is unavailable for rollback'
  [[ "$(stat -c '%U:%G:%a' "${state_file}")" == \
    'root:gpu-platform-admin:640' ]] \
    || h100_fail 'Pilot user state ownership or mode is invalid'
  [[ "$(state_value VERSION)" == 2 \
    && "$(state_value STATUS)" == ACTIVE \
    && "$(state_value SSH_KEY_STATE)" == INSTALLED \
    && "$(state_value USERNAME)" == "${user_name}" ]] \
    || h100_fail 'ACTIVE user state is invalid for rollback'
  user_uid="$(state_value UID)"
  user_gid="$(state_value GID)"
  project_id="$(state_value PROJECT_ID)"
  ssh_port="$(state_value SSH_PORT)"
  slurm_account="$(state_value SLURM_ACCOUNT)"
  slurm_qos="$(state_value SLURM_QOS)"
  project_name="h100_${user_name}"
  user_root="${H100_DATA_ROOT}/users/${user_name}"
  workspace_root="${H100_WORKSPACE_ROOT}/${user_uid}"
  validate_identity_numbers
  [[ "$(id -u "${user_name}")" == "${user_uid}" \
    && "$(id -g "${user_name}")" == "${user_gid}" ]] \
    || h100_fail 'managed identity changed before Activate rollback'
}

assert_forbidden_groups_absent() {
  local forbidden_group
  for forbidden_group in sudo docker video render gpu-platform-admin adm systemd-journal; do
    if id -nG "${user_name}" | tr ' ' '\n' | grep -Fxq "${forbidden_group}"; then
      h100_fail "Pilot user belongs to forbidden group: ${forbidden_group}"
    fi
  done
}

validate_container_security() {
  local container
  container="$(h100_container_name "${user_name}")"
  docker inspect "${container}" | jq -e \
    --arg expected_name "${container}" \
    --arg expected_port "${ssh_port}" '
      .[0] as $c
      | ($c.Name | ltrimstr("/")) == $expected_name
      and ($c.Image | startswith("sha256:"))
      and $c.HostConfig.Privileged == false
      and $c.HostConfig.NetworkMode != "host"
      and $c.HostConfig.PidMode != "host"
      and $c.HostConfig.IpcMode != "host"
      and (($c.HostConfig.DeviceRequests // []) | length == 0)
      and (($c.HostConfig.Devices // []) | length == 0)
      and (($c.Mounts // []) | map(.Destination) | index("/var/run/docker.sock") | not)
      and (($c.Mounts // []) | map(.Destination) | index("/etc") | not)
      and (($c.Mounts // []) | map(.Destination) | index("/root") | not)
      and (($c.Mounts // []) | map(.Destination) | index("/var/run") | not)
      and (($c.Mounts // []) | map(.Destination) | index("/run/munge") | not)
      and $c.HostConfig.PortBindings["22/tcp"][0].HostPort == $expected_port
    ' >/dev/null || h100_fail 'long-lived container security validation failed'
}

assert_container_stopped() {
  local container
  container="$(h100_container_name "${user_name}")"
  [[ "$(docker inspect --format '{{.State.Running}}' "${container}")" == false ]] \
    || h100_fail 'staged container must be stopped'
  ! ss -H -lnt "sport = :${ssh_port}" | grep -q . \
    || h100_fail 'staged container SSH port is listening'
}

enable_and_verify_guard() {
  local guard_output managed verified
  systemctl start "${GUARD_SERVICE}"
  systemctl enable --now "${GUARD_TIMER}"
  guard_timer_changed=1
  systemctl is-enabled --quiet "${GUARD_TIMER}" \
    || h100_fail 'GPU bypass Guard timer was not enabled'
  systemctl is-active --quiet "${GUARD_TIMER}" \
    || h100_fail 'GPU bypass Guard timer is not active'
  guard_output="$(journalctl -u "${GUARD_SERVICE}" --since '-2 minutes' \
    --no-pager -o cat 2>/dev/null)" \
    || h100_fail 'GPU bypass Guard result is unavailable'
  [[ "${guard_output}" =~ GPU[[:space:]]BYPASS[[:space:]]GUARD[[:space:]]PASSED[[:space:]]managed_users=([0-9]+)[[:space:]]users_verified=([0-9]+) ]] \
    || h100_fail 'GPU bypass Guard did not report a successful managed-user verification'
  managed=${BASH_REMATCH[1]}
  verified=${BASH_REMATCH[2]}
  ((managed >= 1 && managed == verified)) \
    || h100_fail 'GPU bypass Guard managed/verified user counts differ'
}

prepare_common_paths() {
  project_name="h100_${user_name}"
  user_root="${H100_DATA_ROOT}/users/${user_name}"
  if [[ -n "${user_uid}" ]]; then
    workspace_root="${H100_WORKSPACE_ROOT}/${user_uid}"
  fi
  state_file="${STATE_DIR}/${user_name}.state"
}

run_plan() {
  validate_new_user_plan
  printf '%s\n' \
    "PLAN user=${user_name} uid=${user_uid} gid=${user_gid}" \
    "STAGE shell=/usr/sbin/nologin password=locked authorized_keys=absent ssh_key=NOT_REQUIRED_FOR_STAGE" \
    "GPU_POLICY unit=user-${user_uid}.slice policy=closed DeviceAllow=none" \
    "SLURM account=${slurm_account} qos=${slurm_qos} max_gpus=1" \
    "QUOTA project_id=${project_id} hard_limit_gb=300" \
    "CONTAINER name=gpu-dev-${user_name} ssh_port=${ssh_port} gpu=none" \
    'ACTIVATE requires a separate --confirm-activate transaction'
}

atomic_append_project_mappings() {
  local projects_temp projid_temp
  projects_temp="$(mktemp /etc/.projects.h100.XXXXXX)"
  projid_temp="$(mktemp /etc/.projid.h100.XXXXXX)"
  cp -- /etc/projects "${projects_temp}"
  printf '\n' >>"${projects_temp}"
  printf '%s:%s\n' "${project_id}" "${workspace_root}" >>"${projects_temp}"
  cp -- /etc/projid "${projid_temp}"
  printf '\n' >>"${projid_temp}"
  printf '%s:%s\n' "${project_name}" "${project_id}" >>"${projid_temp}"
  chown root:root "${projects_temp}" "${projid_temp}"
  chmod 0644 "${projects_temp}" "${projid_temp}"
  sync -f "${projects_temp}"
  sync -f "${projid_temp}"
  mv -f -- "${projects_temp}" /etc/projects
  mv -f -- "${projid_temp}" /etc/projid
}

run_stage() {
  validate_new_user_plan
  local stamp
  stamp="$(date +%Y%m%d-%H%M%S-%N)"
  backup_dir="${H100_PLATFORM_ROOT}/backups/user-stage-${user_name}-${stamp}"
  report_file="${H100_PLATFORM_ROOT}/reports/user-stage-${user_name}-${stamp}.md"
  install -d -o root -g gpu-platform-admin -m 0750 "${backup_dir}"
  cp -a /etc/projects "${backup_dir}/projects.before"
  cp -a /etc/projid "${backup_dir}/projid.before"
  timer_was_enabled=0
  systemctl is-enabled --quiet "${GUARD_TIMER}" && timer_was_enabled=1
  ROLLBACK_KIND=stage

  groupadd --gid "${user_gid}" "${user_name}"
  useradd \
    --uid "${user_uid}" \
    --gid "${user_gid}" \
    --create-home \
    --home-dir "/home/${user_name}" \
    --shell /usr/sbin/nologin \
    "${user_name}"
  account_created=1
  passwd -l "${user_name}" >/dev/null
  [[ "$(getent passwd "${user_name}" | cut -d: -f7)" == /usr/sbin/nologin ]] \
    || h100_fail 'staged account shell is not nologin'
  [[ "$(passwd -S "${user_name}" | awk '{print $2}')" == L ]] \
    || h100_fail 'staged account password is not locked'
  [[ ! -e "/home/${user_name}/.ssh/authorized_keys" ]] \
    || h100_fail 'authorized_keys unexpectedly exists before isolation'
  assert_forbidden_groups_absent

  "${ISOLATION_TOOL}" apply "${user_name}"
  isolation_applied=1
  "${ISOLATION_TOOL}" self-test "${user_name}"

  install -d -o "${user_name}" -g "${user_name}" -m 0710 "${user_root}"
  install -d -o "${user_name}" -g "${user_name}" -m 0700 \
    "${user_root}/home" "${user_root}/home/.ssh"
  install -d -o "${user_name}" -g "${user_name}" -m 0700 \
    "${workspace_root}" \
    "${workspace_root}/projects" \
    "${workspace_root}/datasets" \
    "${workspace_root}/outputs" \
    "${workspace_root}/.portal" \
    "${workspace_root}/.portal/job-scripts" \
    "${workspace_root}/.portal/jobs"
  install -d -o root -g root -m 0700 \
    "${H100_DATA_ROOT}/container-data/${user_name}" \
    "${H100_DATA_ROOT}/container-data/${user_name}/ssh-host-keys"
  [[ ! -e "${user_root}/home/.ssh/authorized_keys" ]] \
    || h100_fail 'managed-home authorized_keys unexpectedly exists during stage'

  atomic_append_project_mappings
  project_mappings_changed=1
  xfs_quota -x -c "project -s ${project_name}" "${H100_DATA_ROOT}"
  xfs_quota -x -c "limit -p bhard=300g ${project_name}" "${H100_DATA_ROOT}"
  xfs_quota -x -c 'report -p -h' "${H100_DATA_ROOT}" \
    | grep -E "^${project_name}[[:space:]]" \
    | grep -q '300G' \
    || h100_fail '300GB project quota validation failed'

  sacctmgr -i add user "${user_name}" \
    Account="${slurm_account}" \
    DefaultAccount="${slurm_account}" \
    QOS="${slurm_qos},${MULTIGPU_QOS}" \
    DefaultQOS="${slurm_qos}" >/dev/null
  sacctmgr -i modify user where Name="${user_name}" Account="${slurm_account}" \
    set MaxTRES=gres/gpu=4 GrpTRES=gres/gpu=4 >/dev/null
  association_created=1
  sacctmgr -nP show assoc where \
    User="${user_name}" Account="${slurm_account}" \
    format=User,Account,QOS,DefaultQOS,MaxTRES,GrpTRES \
    | awk -F'|' -v user="${user_name}" -v account="${slurm_account}" \
      -v multi="${MULTIGPU_QOS}" \
      '$1 == user && $2 == account && $3 ~ /general/ && $3 ~ multi \
       && $4 == "general" && $5 ~ /(^|,)gres\/gpu=4(,|$)/ \
       && $6 ~ /(^|,)gres\/gpu=4(,|$)/ \
       {found=1} END {exit found ? 0 : 1}' \
    || h100_fail 'Slurm association validation failed'

  h100-container-create "${user_name}" "${ssh_port}"
  container_created=1
  validate_container_security
  h100-container-stop "${user_name}"
  assert_container_stopped
  [[ ! -e "/home/${user_name}/.ssh/authorized_keys" ]] \
    || h100_fail 'host authorized_keys appeared during stage'
  [[ ! -e "${user_root}/home/.ssh/authorized_keys" ]] \
    || h100_fail 'container authorized_keys appeared during stage'
  "${ISOLATION_TOOL}" verify "${user_name}"
  enable_and_verify_guard
  write_state STAGED
  {
    printf '# H100 Pilot user staged\n\n'
    printf -- '- User: `%s`\n' "${user_name}"
    printf -- '- UID:GID: `%s:%s`\n' "${user_uid}" "${user_gid}"
    printf -- '- Status: `STAGED`\n'
    printf -- '- Host shell: `/usr/sbin/nologin`\n'
    printf -- '- Password: locked\n'
    printf -- '- authorized_keys: not installed\n'
    printf -- '- GPU policy: `user-%s.slice DevicePolicy=closed`\n' "${user_uid}"
    printf -- '- NVIDIA DeviceAllow: absent\n'
    printf -- '- Slurm: account `%s`, QOS `%s`, max GPU 1\n' \
      "${slurm_account}" "${slurm_qos}"
    printf -- '- Project quota: `%s`, 300GB hard\n' "${project_id}"
    printf -- '- Container: `gpu-dev-%s`, GPU request none\n' "${user_name}"
    printf -- '- Container state: `STOPPED`; SSH port is not listening\n'
    printf -- '- SSH key state: `REQUIRED_BEFORE_ACTIVATION`\n'
    printf -- '- GPU bypass Guard timer: enabled and verified\n'
    printf -- '- Separate activation approval required\n'
    printf -- '- Backup: `%s`\n' "${backup_dir}"
  } >"${report_file}"
  ROLLBACK_KIND=
  printf 'STAGED user=%s uid=%s shell=/usr/sbin/nologin password=locked authorized_keys=absent ssh_key=REQUIRED_BEFORE_ACTIVATION guard_timer=enabled\n' \
    "${user_name}" "${user_uid}"
}

install_normalized_keys() {
  local target=$1 owner=$2 group=$3 temp
  [[ ! -e "${target}" && ! -L "${target}" ]] \
    || h100_fail 'authorized_keys target must be absent before activation'
  [[ ! -L "$(dirname "${target}")" ]] \
    || h100_fail 'authorized_keys parent must not be a symlink'
  temp="$(mktemp "$(dirname "${target}")/.authorized_keys.XXXXXX")"
  printf '%s\n' "${normalized_keys[@]}" >"${temp}"
  chown "${owner}:${group}" "${temp}"
  chmod 0600 "${temp}"
  sync -f "${temp}"
  mv -fT -- "${temp}" "${target}"
  sync -f "$(dirname "${target}")"
}

validate_installed_keys() {
  local target=$1 expected_uid=$2 expected_gid=$3
  local approved_hash=${key_hash} approved_fingerprints=${key_fingerprints_csv}
  local approved_input=${public_key_input}
  public_key_input=${target}
  parse_public_key_file 0 "${expected_uid}" "${expected_gid}"
  [[ "${key_hash}" == "${approved_hash}" \
    && "${key_fingerprints_csv}" == "${approved_fingerprints}" ]] \
    || h100_fail 'installed authorized_keys fingerprints do not match approval'
  public_key_input=${approved_input}
  key_hash=${approved_hash}
  key_fingerprints_csv=${approved_fingerprints}
}

validate_staged_resources() {
  assert_forbidden_groups_absent
  "${ISOLATION_TOOL}" verify "${user_name}"
  "${ISOLATION_TOOL}" self-test "${user_name}"
  grep -Fxq "${project_id}:${workspace_root}" /etc/projects \
    || h100_fail 'staged project mapping is missing'
  grep -Fxq "${project_name}:${project_id}" /etc/projid \
    || h100_fail 'staged project name mapping is missing'
  xfs_quota -x -c 'report -p -h' "${H100_DATA_ROOT}" \
    | grep -E "^${project_name}[[:space:]]" \
    | grep -q '300G' \
    || h100_fail 'staged 300GB project quota validation failed'
  sacctmgr -nP show assoc where \
    User="${user_name}" Account="${slurm_account}" \
    format=User,Account,QOS,DefaultQOS,MaxTRES,GrpTRES \
    | awk -F'|' -v user="${user_name}" -v account="${slurm_account}" \
      -v multi="${MULTIGPU_QOS}" \
      '$1 == user && $2 == account && $3 ~ /general/ && $3 ~ multi \
       && $4 == "general" && $5 ~ /(^|,)gres\/gpu=4(,|$)/ \
       && $6 ~ /(^|,)gres\/gpu=4(,|$)/ \
       {found=1} END {exit found ? 0 : 1}' \
    || h100_fail 'staged Slurm association validation failed'
  local qos_record
  qos_record="$(sacctmgr -nP show qos "${slurm_qos}" format=Name,MaxTRESPerUser)"
  grep -Eq "^${slurm_qos}\\|.*gres/gpu=1" <<<"${qos_record}" \
    || h100_fail 'staged Slurm QOS GPU limit validation failed'
  sacctmgr -nP show qos "${MULTIGPU_QOS}" format=Name,MaxTRESPerUser \
    | awk -F'|' -v qos="${MULTIGPU_QOS}" \
        '$1 == qos && $2 ~ /gres\/gpu=4/ {found=1} END {exit !found}' \
    || h100_fail 'staged approved multi-GPU QOS validation failed'
  validate_container_security
  assert_container_stopped
  [[ ! -e "/home/${user_name}/.ssh/authorized_keys" ]] \
    || h100_fail 'host authorized_keys must be absent before activation'
  [[ ! -e "${user_root}/home/.ssh/authorized_keys" ]] \
    || h100_fail 'managed-home authorized_keys must be absent before activation'
  systemctl start "${GUARD_SERVICE}"
  systemctl is-enabled --quiet "${GUARD_TIMER}" \
    || h100_fail 'GPU bypass Guard timer is not enabled for staged user'
  systemctl is-active --quiet "${GUARD_TIMER}" \
    || h100_fail 'GPU bypass Guard timer is not active for staged user'
}

run_activate() {
  # Public-key bytes are validated before state or resource mutation. The
  # accepted path is constrained to the root-owned Portal staging directory.
  validate_public_keys
  load_staged_state
  h100_require_slurm_drained
  [[ "$(squeue -h | wc -l)" -eq 0 ]] || h100_fail 'Slurm queue must be empty'
  validate_staged_resources

  local stamp container
  stamp="$(date +%Y%m%d-%H%M%S-%N)"
  backup_dir="${H100_PLATFORM_ROOT}/backups/user-activate-${user_name}-${stamp}"
  report_file="${H100_PLATFORM_ROOT}/reports/user-activate-${user_name}-${stamp}.md"
  install -d -o root -g gpu-platform-admin -m 0750 "${backup_dir}"
  cp -a "${state_file}" "${backup_dir}/state.before"
  timer_was_enabled=0
  systemctl is-enabled --quiet "${GUARD_TIMER}" && timer_was_enabled=1
  container="$(h100_container_name "${user_name}")"
  if [[ "$(docker inspect --format '{{.State.Running}}' "${container}")" == true ]]; then
    docker stop --time 30 "${container}" >/dev/null
  fi
  ROLLBACK_KIND=activate

  install -d -o "${user_name}" -g "${user_name}" -m 0700 "/home/${user_name}/.ssh"
  select_host_key_set
  install_normalized_keys "/home/${user_name}/.ssh/authorized_keys" \
    "${user_name}" "${user_name}"
  host_key_installed=1
  validate_installed_keys "/home/${user_name}/.ssh/authorized_keys" \
    "${user_uid}" "${user_gid}"

  select_container_key_set
  install_normalized_keys "${user_root}/home/.ssh/authorized_keys" \
    "${user_name}" "${user_name}"
  data_key_installed=1
  validate_installed_keys "${user_root}/home/.ssh/authorized_keys" \
    "${user_uid}" "${user_gid}"
  select_combined_key_state

  systemctl start "${GUARD_SERVICE}"
  systemctl enable --now "${GUARD_TIMER}"
  systemctl is-enabled --quiet "${GUARD_TIMER}" \
    || h100_fail 'GPU bypass Guard timer was not enabled'
  usermod --shell /bin/bash "${user_name}"
  [[ "$(getent passwd "${user_name}" | cut -d: -f7)" == /bin/bash ]] \
    || h100_fail 'approved login shell activation failed'
  [[ "$(passwd -S "${user_name}" | awk '{print $2}')" == L ]] \
    || h100_fail 'password unexpectedly became usable'
  # The fixed container-start tool independently requires ACTIVE lifecycle
  # metadata and verifies the persistent container authorized_keys against it.
  # Any failure after this atomic write is returned to STAGED by rollback_activate.
  write_state ACTIVE
  h100-container-start "${user_name}"
  validate_container_security
  "${ISOLATION_TOOL}" verify "${user_name}"
  {
    printf '# H100 Pilot user activated\n\n'
    printf -- '- User: `%s`\n' "${user_name}"
    printf -- '- Status: `ACTIVE`\n'
    printf -- '- Host shell: `/bin/bash`\n'
    printf -- '- Password authentication credential: locked\n'
    printf -- '- Host public keys: `%s` installed after GPU isolation revalidation\n' \
      "${#host_normalized_keys[@]}"
    printf -- '- Container public keys: `%s` installed independently\n' \
      "${#container_normalized_keys[@]}"
    printf -- '- GPU policy: `user-%s.slice DevicePolicy=closed`\n' "${user_uid}"
    printf -- '- Long-lived container GPU: none\n'
    printf -- '- GPU bypass Guard timer: enabled\n'
    printf -- '- User SSH and Pilot Slurm acceptance remain human verification steps\n'
  } >"${report_file}"
  ROLLBACK_KIND=
  printf 'ACTIVE user=%s uid=%s guard_timer=enabled password=locked\n' \
    "${user_name}" "${user_uid}"
}

run_activate_rollback() {
  # This fixed recovery path is invoked only by the Root Worker when a real
  # Activate cannot be committed end to end.  It preserves all staged
  # resources and user data while fail-closing both SSH targets.
  load_active_state_for_rollback
  h100_require_slurm_drained
  [[ "$(squeue -h | wc -l)" -eq 0 ]] || h100_fail 'Slurm queue must be empty'

  local stamp container host_authorized_keys container_authorized_keys
  stamp="$(date +%Y%m%d-%H%M%S-%N)"
  backup_dir="${H100_PLATFORM_ROOT}/backups/user-activate-rollback-${user_name}-${stamp}"
  report_file="${H100_PLATFORM_ROOT}/reports/user-activate-rollback-${user_name}-${stamp}.md"
  install -d -o root -g gpu-platform-admin -m 0750 "${backup_dir}"
  cp -a "${state_file}" "${backup_dir}/state.active.before"

  # Disable the host login path before handling key files, then stop the
  # container before removing its persistent authorization file.
  usermod --shell /usr/sbin/nologin "${user_name}"
  passwd -l "${user_name}" >/dev/null
  container="$(h100_container_name "${user_name}")"
  if docker container inspect "${container}" >/dev/null 2>&1; then
    docker stop --time 30 "${container}" >/dev/null || true
  fi

  host_authorized_keys="/home/${user_name}/.ssh/authorized_keys"
  container_authorized_keys="${user_root}/home/.ssh/authorized_keys"
  if [[ -e "${host_authorized_keys}" || -L "${host_authorized_keys}" ]]; then
    mv -fT -- "${host_authorized_keys}" "${backup_dir}/host-authorized_keys.rolled-back"
  fi
  if [[ -e "${container_authorized_keys}" || -L "${container_authorized_keys}" ]]; then
    mv -fT -- "${container_authorized_keys}" \
      "${backup_dir}/container-authorized_keys.rolled-back"
  fi
  rmdir -- "/home/${user_name}/.ssh" 2>/dev/null || true

  write_state STAGED
  [[ "$(getent passwd "${user_name}" | cut -d: -f7)" == /usr/sbin/nologin ]] \
    || h100_fail 'Activate rollback did not restore nologin'
  [[ "$(passwd -S "${user_name}" | awk '{print $2}')" == L ]] \
    || h100_fail 'Activate rollback did not preserve the password lock'
  validate_staged_resources
  {
    printf '# H100 Pilot user Activate rollback\n\n'
    printf -- '- User: `%s`\n' "${user_name}"
    printf -- '- Result: `ROLLED_BACK TO STAGED`\n'
    printf -- '- Shell: `/usr/sbin/nologin`\n'
    printf -- '- Password: locked\n'
    printf -- '- Host authorized_keys: absent\n'
    printf -- '- Container authorized_keys: absent\n'
    printf -- '- Container: stopped\n'
    printf -- '- Per-UID GPU policy, quota, Slurm association and user data: retained\n'
    printf -- '- Slurm node: remains DRAIN\n'
  } >"${report_file}"
  printf 'ROLLED_BACK user=%s state=STAGED shell=/usr/sbin/nologin password=locked authorized_keys=absent container=stopped\n' \
    "${user_name}"
}

run_status() {
  h100_validate_username "${user_name}"
  state_file="${STATE_DIR}/${user_name}.state"
  if [[ ! -e "${state_file}" ]]; then
    printf 'user=%s lifecycle=ABSENT\n' "${user_name}"
    return 0
  fi
  [[ -f "${state_file}" && ! -L "${state_file}" ]] \
    || h100_fail 'invalid Pilot state file type'
  local status uid shell registered timer container_state
  status="$(state_value STATUS)"
  uid="$(state_value UID)"
  shell="$(getent passwd "${user_name}" | cut -d: -f7 || printf absent)"
  registered=no
  awk -v name="${user_name}" -v uid="${uid}" \
    '$0 !~ /^[[:space:]]*(#|$)/ && $1 == name && $2 == uid {found=1} END {exit found ? 0 : 1}' \
    /etc/h100-platform/gpu-isolated-users && registered=yes
  timer="$(systemctl is-enabled "${GUARD_TIMER}" 2>/dev/null || true)"
  container_state="$(docker inspect --format '{{.State.Status}}' \
    "$(h100_container_name "${user_name}")" 2>/dev/null || printf absent)"
  printf 'user=%s lifecycle=%s uid=%s shell=%s gpu_registry=%s container=%s guard_timer=%s\n' \
    "${user_name}" "${status}" "${uid}" "${shell}" "${registered}" \
    "${container_state}" "${timer}"
}

if (($# == 0)); then
  usage >&2
  exit 2
fi
case "$1" in
  --help|-h)
    usage
    exit 0
    ;;
  --plan)
    if (($# != 8)); then
      (($# == 9)) && h100_fail 'PUBLIC_KEY_NOT_ALLOWED_DURING_PLAN'
      usage >&2
      exit 2
    fi
    mode=plan
    user_name=$2
    user_uid=$3
    user_gid=$4
    project_id=$5
    ssh_port=$6
    slurm_account=$7
    slurm_qos=$8
    ;;
  --stage)
    for argument in "$@"; do
      case "${argument}" in
        --public-key-file|--host-public-key-file|--container-public-key-file)
          h100_fail 'PUBLIC_KEY_NOT_ALLOWED_DURING_STAGE'
          ;;
      esac
    done
    if (($# != 10)); then
      (($# == 11)) && h100_fail 'PUBLIC_KEY_NOT_ALLOWED_DURING_STAGE'
      usage >&2
      exit 2
    fi
    [[ "$9" == --confirm-stage && "${10}" == "$2" ]] \
      || h100_fail 'stage confirmation must repeat the exact username'
    mode=stage
    user_name=$2
    user_uid=$3
    user_gid=$4
    project_id=$5
    ssh_port=$6
    slurm_account=$7
    slurm_qos=$8
    ;;
  --activate)
    (($# >= 2)) || h100_fail 'PUBLIC_KEY_REQUIRED_FOR_ACTIVATION'
    mode=activate
    user_name=$2
    if (($# == 6)) && [[ "$3" == --public-key-file && -n "$4" ]]; then
      [[ "$5" == --confirm-activate && "$6" == "$2" ]] \
        || h100_fail 'activation confirmation must repeat the exact username'
      host_public_key_input=$4
      container_public_key_input=$4
    elif (($# == 8)) \
      && [[ "$3" == --host-public-key-file && -n "$4" ]] \
      && [[ "$5" == --container-public-key-file && -n "$6" ]]; then
      [[ "$7" == --confirm-activate && "$8" == "$2" ]] \
        || h100_fail 'activation confirmation must repeat the exact username'
      host_public_key_input=$4
      container_public_key_input=$6
    else
      for argument in "$@"; do
        case "${argument}" in
          --public-key-file|--host-public-key-file|--container-public-key-file)
            h100_fail 'PUBLIC_KEY_TARGET_SCOPE_INVALID'
            ;;
        esac
      done
      h100_fail 'PUBLIC_KEY_REQUIRED_FOR_ACTIVATION'
    fi
    ;;
  --rollback-activate)
    (($# == 4)) || { usage >&2; exit 2; }
    [[ "$3" == --confirm-rollback-activate && "$4" == "$2" ]] \
      || h100_fail 'Activate rollback confirmation must repeat the exact username'
    mode=rollback-activate
    user_name=$2
    ;;
  --status)
    (($# == 2)) || { usage >&2; exit 2; }
    mode=status
    user_name=$2
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

h100_require_root
h100_acquire_lock
trap on_exit EXIT
prepare_common_paths
temp_dir="$(mktemp -d /tmp/h100-user-create.XXXXXX)"
case "${mode}" in
  plan) run_plan ;;
  stage) run_stage ;;
  activate) run_activate "$@" ;;
  rollback-activate) run_activate_rollback ;;
  status) run_status ;;
esac
OUTCOME=SUCCESS
