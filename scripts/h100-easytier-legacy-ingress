#!/usr/bin/env bash
set -euo pipefail

source /usr/local/lib/h100-platform/h100-platform-common.sh

readonly LEGACY_INTERFACE=tun0
readonly MANAGED_PORT_RANGE=22023:22999
readonly RULE_COMMENT=h100-easytier-legacy-container-ssh
readonly IPTABLES=/usr/sbin/iptables

usage() {
  printf 'Usage: h100-easytier-legacy-ingress {apply|check|remove}\n'
}

if (($# != 1)) || [[ "$1" != apply && "$1" != check && "$1" != remove ]]; then
  usage >&2
  exit 2
fi

readonly action=$1
h100_require_root

rule=(
  -i "${LEGACY_INTERFACE}"
  -d "${H100_LEGACY_PUBLIC_ACCESS_IP}/32"
  -p tcp --dport "${MANAGED_PORT_RANGE}"
  -m comment --comment "${RULE_COMMENT}"
  -j DNAT --to-destination "${H100_PUBLIC_ACCESS_IP}"
)

interfaces_active() {
  ip -brief address show dev "${LEGACY_INTERFACE}" \
    | grep -Eq "^[^[:space:]]+[[:space:]]+(UP|UNKNOWN)[[:space:]]+.*${H100_LEGACY_PUBLIC_ACCESS_IP}/" \
    && ip -brief address \
      | grep -Eq "^[^[:space:]]+[[:space:]]+(UP|UNKNOWN)[[:space:]]+.*${H100_PUBLIC_ACCESS_IP}/"
}

rule_present() {
  "${IPTABLES}" -w 5 -t nat -C PREROUTING "${rule[@]}" >/dev/null 2>&1
}

case "${action}" in
  apply)
    for _attempt in $(seq 1 60); do
      interfaces_active && break
      sleep 0.5
    done
    interfaces_active \
      || h100_fail 'both EasyTier ingress interfaces must be active'
    if ! rule_present; then
      "${IPTABLES}" -w 5 -t nat -I PREROUTING 1 "${rule[@]}"
    fi
    rule_present || h100_fail 'legacy EasyTier SSH ingress rule was not installed'
    printf 'LEGACY EASYTIER SSH INGRESS ACTIVE address=%s ports=%s target=%s\n' \
      "${H100_LEGACY_PUBLIC_ACCESS_IP}" "${MANAGED_PORT_RANGE}" "${H100_PUBLIC_ACCESS_IP}"
    ;;
  check)
    interfaces_active || h100_fail 'both EasyTier ingress interfaces are not active'
    rule_present || h100_fail 'legacy EasyTier SSH ingress rule is absent'
    printf 'LEGACY EASYTIER SSH INGRESS PASS\n'
    ;;
  remove)
    while rule_present; do
      "${IPTABLES}" -w 5 -t nat -D PREROUTING "${rule[@]}"
    done
    printf 'LEGACY EASYTIER SSH INGRESS REMOVED\n'
    ;;
esac
