#!/usr/bin/env bash
set -euo pipefail

source /usr/local/lib/h100-platform/h100-platform-common.sh

if [[ "${1:-}" == --help || $# -ne 1 ]]; then
  printf 'Usage: sudo h100-container-status USER\n'
  [[ "${1:-}" == --help ]] && exit 0 || exit 2
fi

readonly user_name=$1
h100_require_root
h100_validate_username "${user_name}"
h100_acquire_lock shared
h100_install_audit_trap container-status "${user_name}"
h100_require_managed_user "${user_name}"

container="$(h100_container_name "${user_name}")"
if ! docker container inspect "${container}" >/dev/null 2>&1; then
  printf 'user=%s container=%s state=absent data=preserved\n' \
    "${user_name}" "${container}"
  h100_mark_success
  exit 0
fi

docker inspect "${container}" \
  | jq -r '
      .[0]
      | "user='"${user_name}"' container=\(.Name | ltrimstr("/")) state=\(.State.Status) health=\(.State.Health.Status // "n/a") image=\(.Config.Image) privileged=\(.HostConfig.Privileged) network=\(.HostConfig.NetworkMode) cpu_nano=\(.HostConfig.NanoCpus) memory_bytes=\(.HostConfig.Memory) pids=\(.HostConfig.PidsLimit) gpu_requests=\((.HostConfig.DeviceRequests // []) | length)"
    '
h100_mark_success
